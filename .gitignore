# Generated by Cargo
# will have compiled files and executables
/debug
/target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# Optionally ignore Cargo.lock if your project is a library
# For executables, you usually want to track Cargo.lock for reproducible builds
# Cargo.lock

# Node dependencies
node_modules

# Nuxt dev/build outputs (if using Nuxt)
.output
.data
.nuxt
.nitro
.cache

# Vue build output directory (commonly 'dist' or 'build')
/dist
/build

# Local environment variables
.env.local
.env.*.local
.env

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# WebAssembly (Wasm) build artifacts
# The wasm binary file itself, usually a build artifact
*.wasm

# The generated JavaScript wrapper/loader file
*.js

# The generated TypeScript declaration file (optional, depends on setup)
*.ts

# Common output directory for wasm-pack and other build tools
/pkg

# General build output folders, if not already covered
/target